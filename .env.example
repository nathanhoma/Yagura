# Optional local OpenAI-compatible LLM endpoint. Keep the host local/private.
APP_HOST=127.0.0.1
APP_PORT=8080
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Auto-select the model only when /models advertises exactly one model.
# Maximum model request duration in milliseconds (100–60000).
LLM_TIMEOUT_MS=30000
